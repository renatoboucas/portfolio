NEXT_PUBLIC_SITE_URL=https://renatoboucas.com
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_CONSENT_DEBUG=false
OPENAI_API_KEY=

# --- /lottery access gate + proxy ---
# Shared username/password required to open renatoboucas.com/lottery.
LOTTERY_USERNAME=
LOTTERY_PASSWORD=
# Random secret used to sign the session cookie (e.g. `openssl rand -hex 32`).
LOTTERY_SESSION_SECRET=
# Origin of the standalone number-charm (Vite) deployment that /lottery proxies to.
LOTTERY_APP_ORIGIN=https://number-charm.vercel.app
